<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SporeholmLauncher.Core</RootNamespace>
    <AssemblyName>SporeholmLauncher.Core</AssemblyName>
    <!-- Pure BCL: no NuGet dependencies, so this engine builds + tests anywhere
         a .NET 8 SDK exists, independent of the Avalonia GUI. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SporeholmLauncher.Core.Tests" />
  </ItemGroup>

</Project>
