<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SporeholmLauncher.Core;assembly=SporeholmLauncher.Core"
        x:Class="SporeholmLauncher.App.Views.MainWindow"
        Title="Sporeholm" Icon="/icon.ico" Width="720" Height="620"
        MinWidth="560" MinHeight="520"
        Background="#1b1d23">

  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header + Settings -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="SPOREHOLM" FontSize="30" FontWeight="Bold" Foreground="#7fd17a"/>
        <TextBlock Text="a colony of mushroom-folk" FontSize="13" Foreground="#9aa0aa"/>
      </StackPanel>
      <Button Grid.Column="1" Content="⚙  Settings" VerticalAlignment="Top" Click="OnSettings"
              ToolTip.Tip="Auto-updates, choose a release, mods, rollback, offline."/>
    </Grid>

    <!-- Version / source line -->
    <TextBlock Grid.Row="1" x:Name="VersionLine" Margin="0,16,0,10"
               Foreground="#cdd2da" Text="Checking…"
               ToolTip.Tip="Your installed version and the release being tracked."/>

    <!-- News / changelog feed (main area) -->
    <Border Grid.Row="2" Background="#23262e" CornerRadius="8" Padding="14" Margin="0,0,0,14">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="News" FontWeight="SemiBold" Foreground="#9aa0aa" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1">
          <StackPanel>
            <ItemsControl x:Name="NewsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:NewsEntry">
                  <StackPanel Margin="0,0,0,16" Spacing="3">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" Foreground="#7fd17a"/>
                    <TextBlock Text="{Binding Date}" FontSize="11" Foreground="#9aa0aa" IsVisible="{Binding HasDate}"/>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="#cdd2da"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="#cdd2da" IsVisible="False"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Bottom bar: progress (left, fills) + Install/Play button (right) -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5" Margin="0,0,16,0">
        <TextBlock x:Name="StatusText" Foreground="#9aa0aa" FontSize="12" Text=""/>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="6" IsVisible="False"/>
      </StackPanel>
      <Button Grid.Column="1" x:Name="MainButton" Content="—" MinWidth="170" Height="52"
              FontSize="18" FontWeight="Bold" Background="#7fd17a" Foreground="#10130f"
              HorizontalContentAlignment="Center" IsEnabled="False" Click="OnMainButton"
              ToolTip.Tip="Install the game, or play it once it's installed."/>
    </Grid>

  </Grid>
</Window>
